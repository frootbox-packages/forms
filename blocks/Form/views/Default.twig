{# frootbox
title: Form
description: A form from the backend, e.g. for contact or registration. Entries arrive by mail and stay in the backend.
group: form
keywords: [Form, Contact, Inquiry, Registration, Mail]
options:
  form: { type: choice, label: Form, source: frootbox/forms/form.choices }
query: [fbForm, fbFormError]
#}
{% if form %}
{% set f = form %}
<section class="forms" id="form-{{ f.id }}"{% if f.language != content_language() %} lang="{{ f.language }}" dir="{{ f.direction }}"{% endif %}>
  {% if f.title %}{{ heading_text(f.title, 0, {class: 'forms__title'}) }}{% endif %}
  <div class="forms__success" role="status" tabindex="-1" data-forms-success{% if not sent %} hidden{% endif %}>
    {%- if sent %}<p>{{ f.success ?: t('Thank you, your message has been sent.') }}</p>{% endif -%}
  </div>
  {% if not sent %}
  <form class="forms__form" method="post" action="{{ f.action }}" data-forms data-forms-token="{{ f.tokenUrl }}" data-forms-thanks="{{ f.success ?: t('Thank you, your message has been sent.') }}" data-forms-failed="{{ t('The form could not be sent. Please check your entries and try again.') }}" data-forms-choose="{{ t('Please choose at least one.') }}">
    {% if failed %}<div class="forms__alert" role="alert" tabindex="-1" data-forms-alert><p>{{ t('The form could not be sent. Please check your entries and try again.') }}</p></div>
    {% else %}<div class="forms__alert" role="alert" tabindex="-1" data-forms-alert hidden></div>{% endif %}
    <input type="hidden" name="_form" value="{{ f.id }}">
    <input type="hidden" name="_language" value="{{ f.language }}">
    <input type="hidden" name="_token" value="{{ f.token }}">
    {% if f.page %}<input type="hidden" name="_page" value="{{ f.page }}">{% endif %}
    <input type="hidden" name="_return" value="{{ f.return }}">
    <div class="forms__trap" aria-hidden="true">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
    </div>
    {% if f.required %}<p class="forms__note">{{ t('Fields marked with * are required.') }}</p>{% endif %}
    {% for field in f.fields %}
      {% set id = 'form-' ~ f.id ~ '-' ~ field.key %}
      {% set described = [field.hint ? id ~ '-hint', id ~ '-error']|filter(v => v)|join(' ') %}
      {% set mark %}{% if field.required %}<span class="forms__required" aria-hidden="true">*</span>{% endif %}{% endset %}
      {% if field.type in ['radio', 'checkboxes'] %}
      <fieldset class="forms__field forms__field--choices" data-forms-field="{{ field.key }}"{% if field.required %} data-required{% endif %} aria-describedby="{{ described }}">
        <legend class="forms__label">{{ field.label }}{{ mark }}</legend>
        {% if field.hint %}<p class="forms__hint" id="{{ id }}-hint">{{ field.hint }}</p>{% endif %}
        {% for option in field.options %}
        <label class="forms__choice">
          <input type="{{ field.type == 'radio' ? 'radio' : 'checkbox' }}" name="values[{{ field.key }}]{{ field.type == 'checkboxes' ? '[]' }}" value="{{ option }}"{% if field.required and field.type == 'radio' %} required{% endif %}>
          <span>{{ option }}</span>
        </label>
        {% endfor %}
        <p class="forms__error" id="{{ id }}-error" data-forms-error hidden></p>
      </fieldset>
      {% elseif field.type in ['checkbox', 'consent'] %}
      <div class="forms__field forms__field--check" data-forms-field="{{ field.key }}">
        <label class="forms__choice">
          <input type="checkbox" id="{{ id }}" name="values[{{ field.key }}]" value="1"{% if field.required %} required{% endif %} aria-describedby="{{ described }}">
          <span>{{ field.label }}{{ mark }}</span>
        </label>
        {% if field.hint %}<p class="forms__hint" id="{{ id }}-hint">{{ field.hint }}</p>{% endif %}
        <p class="forms__error" id="{{ id }}-error" data-forms-error hidden></p>
      </div>
      {% else %}
      <div class="forms__field" data-forms-field="{{ field.key }}">
        <label class="forms__label" for="{{ id }}">{{ field.label }}{{ mark }}</label>
        {% if field.hint %}<p class="forms__hint" id="{{ id }}-hint">{{ field.hint }}</p>{% endif %}
        {% if field.type == 'textarea' %}
        <textarea class="forms__input" id="{{ id }}" name="values[{{ field.key }}]" rows="6" maxlength="{{ field.maxLength }}"{% if field.required %} required{% endif %} aria-describedby="{{ described }}"></textarea>
        {% elseif field.type == 'select' %}
        <select class="forms__input" id="{{ id }}" name="values[{{ field.key }}]"{% if field.required %} required{% endif %} aria-describedby="{{ described }}">
          <option value="">{{ t('Please choose') }}</option>
          {% for option in field.options %}<option>{{ option }}</option>{% endfor %}
        </select>
        {% else %}
        <input class="forms__input" type="{{ field.input }}" id="{{ id }}" name="values[{{ field.key }}]"{% if field.input == 'number' %} step="any"{% else %} maxlength="{{ field.maxLength }}"{% endif %}{% if field.autocomplete %} autocomplete="{{ field.autocomplete }}"{% endif %}{% if field.required %} required{% endif %} aria-describedby="{{ described }}">
        {% endif %}
        <p class="forms__error" id="{{ id }}-error" data-forms-error hidden></p>
      </div>
      {% endif %}
    {% endfor %}
    <div class="forms__actions">
      <button type="submit" class="forms__button">{{ f.button ?: t('Send') }}</button>
    </div>
  </form>
  {% endif %}
</section>
{% elseif editing() %}
<p class="forms__empty">{{ t('Choose a published form in the options of this block.') }}</p>
{% endif %}
