{#- A form: texts by language, recipients and fields in the draft; publishing and deleting (decision 0222), as tabs (decisions 0235, 0237). -#}
{% extends '@backend/layout.twig' %}
{% import '@backend/ui.twig' as ui %}
{% set refresh = 'form-detail' %}
{% set self = path('frootbox.forms.forms.show', {id: form.id}) %}
{% set heading = title ?: t('Without a title') %}
{% set code = language.code %}
{% set dir = language.direction.value %}
{% set editable = can('frootbox/forms/form.update') %}

{% block title %}{{ heading }} · {{ t('Forms') }}{% endblock %}

{% block content %}
<div class="fb-stack fb-stack--lg" id="form-detail">
    {% include '@frootbox/forms/backend/form-header.twig' with {switch: self} %}

    {#- The parts of the form as tabs (decision 0235), the language for all of them in the header;
        the entries are a screen of their own behind the first tab (decision 0237). -#}
    <fb-tab-panels label="{{ t('Parts of the form') }}">
        {% if can('frootbox/forms/entry.list') %}
        <a href="{{ path('frootbox.forms.entries', {id: form.id}) }}?language={{ code }}" data-count="{{ form.entries }}">{{ icon('inbox') }}<span>{{ t('Entries') }}</span></a>
        {% endif %}
        <section id="texts">
            <h2>{{ icon('type') }}{{ t('Texts') }}</h2>
            <div class="fb-card fb-card--padded fb-stack">
                {% if translation %}
                <fb-form action="frootbox/forms/form.update" refresh="{{ refresh }}" done="{{ t('Saved') }}">
                    <form class="fb-stack" novalidate>
                        <input type="hidden" name="id" value="{{ form.id }}">
                        {{ ui.field({label: t('Title'), name: 'translations.' ~ code ~ '.title', id: 'form-title', value: translation.title, required: true, disabled: not editable, attrs: {lang: code, dir: dir, maxlength: 200}}) }}
                        {{ ui.field({label: t('Text of the button'), name: 'translations.' ~ code ~ '.button', id: 'form-button', value: translation.button, optional: true, disabled: not editable, hint: t('Empty for "Send".'), attrs: {lang: code, dir: dir, maxlength: 60}}) }}
                        {{ ui.field({label: t('Text after sending'), name: 'translations.' ~ code ~ '.success', id: 'form-success', value: translation.success, optional: true, multiline: true, disabled: not editable, hint: t('Empty for a general thanks.'), attrs: {lang: code, dir: dir, rows: 3, maxlength: 1000}}) }}
                        {% if editable %}
                        <div class="fb-form__actions">{{ ui.button({label: t('Save'), type: 'submit', saves: true}) }}<p class="fb-form__note">{{ t('Changes go into the draft. Visitors see them after publishing.') }}</p></div>
                        {% endif %}
                    </form>
                </fb-form>
                {% else %}
                <div class="fb-missing">
                    <p class="fb-missing__title">{{ t('No version in {language} yet', {language: language.title}) }}</p>
                    <p class="fb-muted">{{ t('Visitors in this language see the form in the first language.') }}</p>
                    {% if editable %}
                    <fb-form action="frootbox/forms/form.update" refresh="{{ refresh }}" done="{{ t('Saved') }}">
                        <form novalidate>
                            <input type="hidden" name="id" value="{{ form.id }}">
                            <input type="hidden" name="translations.{{ code }}.title" value="{{ source.title }}">
                            {{ ui.button({label: t('Add the version in {language}', {language: language.title}), type: 'submit', variant: 'tonal', icon: 'plus'}) }}
                        </form>
                    </fb-form>
                    {% endif %}
                </div>
                {% endif %}
            </div>
        </section>

        <section id="fields" data-count="{{ fields|length }}">
            <h2>{{ icon('list') }}{{ t('Fields') }}</h2>
            <div class="fb-card">
                <div class="fb-card__header">
                    <p class="fb-muted">{{ t('What visitors fill in, in this order.') }}</p>
                    {% if editable %}{{ ui.button({label: t('Add a field'), variant: 'outline', small: true, icon: 'plus', attrs: {commandfor: 'field-add', command: 'show-modal'}}) }}{% endif %}
                </div>
                {% if fields is empty %}
                <div class="fb-card__body">
                    {{ ui.empty({icon: 'inbox', title: t('No fields yet'), text: t('Add the fields visitors fill in, e.g. name, email and message.')}) }}
                </div>
                {% else %}
                <ol>
                    {%- for field in fields %}
                    <li class="fb-list__item">
                        <span class="fb-list__main">
                            <span class="fb-list__title"{% if field.label %} lang="{{ code }}" dir="{{ dir }}"{% endif %}>{{ field.label ?: t('Without a label') }}</span>
                            <span class="fb-list__meta">{{ t(field.type.title()) }} · <code>{{ field.key }}</code></span>
                        </span>
                        {% if field.required %}{{ ui.badge('neutral', t('Required')) }}{% endif %}
                        {% if editable %}
                        {% set index = loop.index0 %}
                        {% set moves = [{position: index - 1, icon: 'arrow-up', label: t('Move {name} up', {name: field.label ?: field.key}), show: not loop.first}, {position: index + 1, icon: 'arrow-down', label: t('Move {name} down', {name: field.label ?: field.key}), show: not loop.last}] %}
                        {% for move in moves %}
                        {% if move.show %}
                        <fb-form action="frootbox/forms/form.field-move" refresh="{{ refresh }}" done="{{ t('Moved') }}">
                            <form novalidate>
                                <input type="hidden" name="id" value="{{ form.id }}">
                                <input type="hidden" name="key" value="{{ field.key }}">
                                <input type="hidden" name="position" value="{{ move.position }}" data-type="number">
                                {{ ui.button({label: move.label, type: 'submit', variant: 'ghost', small: true, icon: move.icon, icon_only: true}) }}
                            </form>
                        </fb-form>
                        {% endif %}
                        {% endfor %}
                        {{ ui.button({label: t('Edit {name}', {name: field.label ?: field.key}), variant: 'ghost', small: true, icon: 'pencil', icon_only: true, attrs: {commandfor: 'field-update', command: 'show-modal', 'data-fb-fill': field.fill|json_encode}}) }}
                        {{ ui.button({label: t('Remove {name}', {name: field.label ?: field.key}), variant: 'ghost', small: true, icon: 'trash', icon_only: true, attrs: {commandfor: 'field-remove', command: 'show-modal', 'data-fb-fill': {key: field.key}|json_encode}}) }}
                        {% endif %}
                    </li>
                    {%- endfor %}
                </ol>
                {% endif %}
            </div>
        </section>

        <section id="recipients">
            <h2>{{ icon('mail') }}{{ t('Recipients') }}</h2>
            <div class="fb-card fb-card--padded">
                <fb-form action="frootbox/forms/form.update" refresh="{{ refresh }}" done="{{ t('Saved') }}">
                    <form class="fb-stack" novalidate>
                        <input type="hidden" name="id" value="{{ form.id }}">
                        {{ ui.field({label: t('Email addresses'), name: 'recipients', id: 'form-recipients', value: data.recipients|join("\n"), multiline: true, optional: true, disabled: not editable, hint: t('They get every entry, one address per line. Without, the entries are only kept here.'), attrs: {'data-type': 'lines', rows: 3, dir: 'ltr'}}) }}
                        {% if editable %}<div class="fb-form__actions">{{ ui.button({label: t('Save'), type: 'submit', saves: true}) }}</div>{% endif %}
                    </form>
                </fb-form>
            </div>
        </section>

        {% if can('frootbox/forms/form.delete') %}
        <section id="more">
            <h2>{{ icon('settings') }}{{ t('More') }}</h2>
            <div class="fb-card fb-card--padded fb-stack">
                <h3 class="fb-heading-4">{{ t('Delete the form') }}</h3>
                <p class="fb-muted">{{ t(['The form and its entry are deleted. Pages that show it show nothing in its place.', 'The form and its {count} entries are deleted. Pages that show it show nothing in its place.'], {count: form.entries}) }}</p>
                <div class="fb-cluster">{{ ui.button({label: t('Delete the form'), variant: 'danger', attrs: {commandfor: 'form-delete', command: 'show-modal'}}) }}</div>
            </div>
        </section>
        {% endif %}
    </fb-tab-panels>

    {% if editable %}
    {% for dialog in ['field-add', 'field-update'] %}
    {% set adding = dialog == 'field-add' %}
    <dialog class="fb-dialog" id="{{ dialog }}" aria-labelledby="{{ dialog }}-title">
        <fb-form action="frootbox/forms/form.{{ dialog }}" refresh="{{ refresh }}" done="{{ adding ? t('The field is added.') : t('Saved') }}"{% if adding %} reset{% endif %}>
            <form novalidate>
                <input type="hidden" name="id" value="{{ form.id }}">
                {% if not adding %}<input type="hidden" name="key">{% endif %}
                <div class="fb-dialog__body fb-stack">
                    <h2 class="fb-dialog__title" id="{{ dialog }}-title">{{ adding ? t('Add a field') : t('Edit the field') }}</h2>
                    {{ ui.select({label: t('Type'), name: 'type', id: dialog ~ '-type', options: types|map(type => {value: type.value, label: t(type.label)})}) }}
                    {{ ui.field({label: t('Label'), name: 'translations.' ~ code ~ '.label', id: dialog ~ '-label', required: true, attrs: {lang: code, dir: dir, maxlength: 200}}) }}
                    {{ ui.field({label: t('Hint'), name: 'translations.' ~ code ~ '.hint', id: dialog ~ '-hint', optional: true, hint: t('A short help below the field.'), attrs: {lang: code, dir: dir, maxlength: 500}}) }}
                    {{ ui.field({label: t('Options'), name: 'translations.' ~ code ~ '.options', id: dialog ~ '-options', multiline: true, optional: true, hint: t('Only for a drop-down list, one of several and several of several: one option per line.'), attrs: {lang: code, dir: dir, rows: 4, 'data-type': 'lines'}}) }}
                    {{ ui.check({label: t('Required'), name: 'required', id: dialog ~ '-required', hint: t('Visitors must fill it in. Consent is always required.')}) }}
                    {% if pages %}{{ ui.select({label: t('Link'), name: 'link', id: dialog ~ '-link', options: [{value: '', label: t('No link')}]|merge(pages), hint: t('Only for consent, e.g. the privacy policy. Put the text of the link in [square brackets] in the label, else the link follows the label.')}) }}{% endif %}
                </div>
                <div class="fb-dialog__actions">
                    {{ ui.button({label: t('Cancel'), variant: 'outline', attrs: {commandfor: dialog, command: 'close'}}) }}
                    {{ ui.button({label: adding ? t('Add') : t('Save'), type: 'submit'}) }}
                </div>
            </form>
        </fb-form>
    </dialog>
    {% endfor %}

    <dialog class="fb-dialog" id="field-remove" aria-labelledby="field-remove-title">
        <fb-form action="frootbox/forms/form.field-remove" refresh="{{ refresh }}" done="{{ t('The field is removed.') }}">
            <form novalidate>
                <input type="hidden" name="id" value="{{ form.id }}">
                <input type="hidden" name="key">
                <div class="fb-dialog__body">
                    <h2 class="fb-dialog__title" id="field-remove-title">{{ t('Remove the field?') }}</h2>
                    <p>{{ t('Visitors no longer see it once you publish. Entries sent before keep its value.') }}</p>
                </div>
                <div class="fb-dialog__actions">
                    {{ ui.button({label: t('Cancel'), variant: 'outline', attrs: {commandfor: 'field-remove', command: 'close', autofocus: true}}) }}
                    {{ ui.button({label: t('Remove'), variant: 'danger-solid', type: 'submit'}) }}
                </div>
            </form>
        </fb-form>
    </dialog>
    {% endif %}


    {% if can('frootbox/forms/form.delete') %}
    <dialog class="fb-dialog" id="form-delete" aria-labelledby="form-delete-title">
        <fb-form action="frootbox/forms/form.delete" next="{{ path('frootbox.forms.forms') }}" done="{{ t('The form is deleted.') }}">
            <form novalidate>
                <input type="hidden" name="id" value="{{ form.id }}">
                <div class="fb-dialog__body">
                    <h2 class="fb-dialog__title" id="form-delete-title">{{ t('Delete {title}?', {title: heading}) }}</h2>
                    <p>{{ t(['The form and its entry are deleted. Pages that show it show nothing in its place.', 'The form and its {count} entries are deleted. Pages that show it show nothing in its place.'], {count: form.entries}) }}</p>
                </div>
                <div class="fb-dialog__actions">
                    {{ ui.button({label: t('Cancel'), variant: 'outline', attrs: {commandfor: 'form-delete', command: 'close', autofocus: true}}) }}
                    {{ ui.button({label: t('Delete for good'), variant: 'danger-solid', type: 'submit'}) }}
                </div>
            </form>
        </fb-form>
    </dialog>
    {% endif %}
</div>
{% endblock %}
